# Kniha jizd / Evidence vozidel - application environment file.
#
# This file is a TEMPLATE only - it is committed to Git and must never
# contain real secrets. The actual .env is gitignored and always local to
# whichever machine runs the app:
#   - on your machine:  kniha_jizd/.env         (for `uvicorn` run directly on localhost)
#   - on the VPS:       /opt/kniha_jizd/config/.env   (chmod 600, never in Git)
#
# Fully independent from DSS/servis AND from Evidence naradi - own database,
# own secrets, own container/network. Never point this at another app's
# database, and never reuse another app's SESSION_SECRET_KEY here.

# =============================================================================
# LOCAL DEVELOPMENT - copy this file to .env and use as-is to run against the
# local dev Postgres started by `docker compose -f docker/docker-compose.dev.yml up -d`
# (it exposes 127.0.0.1:5435, matching the values below). This is a
# disposable local database - never production data.
# =============================================================================
KJ_DB_NAME=kniha_jizd_dev
KJ_DB_USER=kniha_jizd_dev
KJ_DB_PASSWORD=dev_only_password
DB_HOST=127.0.0.1
DB_PORT=5435

SESSION_SECRET_KEY=dev-only-local-secret-key-not-for-production
ENVIRONMENT=development

PHOTOS_DIR=_local_data/photos
DOCUMENTS_DIR=_local_data/documents

# --- Optional integrations (the app runs fine with all of these unset) ------
# SMTP for e-mail notifications. With SMTP_HOST empty, notifications are
# still recorded in the database and shown in-app, they are just not mailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=kniha-jizd@azunimb.cz
SMTP_STARTTLS=true

# Route-distance check (Etapa 9). Provider "osrm" needs no API key and uses
# the public OSRM/Nominatim demo servers; "none" disables the check entirely
# without breaking anything else.
MAPS_PROVIDER=none
MAPS_NOMINATIM_URL=https://nominatim.openstreetmap.org
MAPS_OSRM_URL=https://router.project-osrm.org
MAPS_USER_AGENT=kniha-jizd/0.1 (solareg.azunimb.cz)

# OCR helper for odometer/receipt photos (Etapa 5). "none" keeps the manual
# entry path only - OCR is never a hard dependency.
OCR_PROVIDER=none
OCR_TESSERACT_CMD=

# TTF font for the logbook PDF export (Etapa 8). Leave empty in Docker: the
# image installs fonts-dejavu-core and the font is found automatically. Set
# it for local development on Windows, where no free Unicode font is
# installed - e.g. PDF_FONT_PATH=C:\Windows\Fonts\arial.ttf. Without a font
# that covers Czech, the PDF is still produced, only with the diacritics
# stripped off six letters (see app/core/pdf_font.py).
PDF_FONT_PATH=

# =============================================================================
# PRODUCTION (VPS) - reference only, do not use these values locally. The
# real file lives at /opt/kniha_jizd/config/.env on the VPS and is never
# committed. DB_HOST is the Docker Compose service name (kniha-jizd-postgres),
# reachable only from inside this app's own internal network - there is no
# host port mapping for Postgres in production.
# =============================================================================
# The database container and the app read the same credentials under two
# different names: POSTGRES_* is what the postgres image itself expects,
# KJ_* is what this app reads. They must match.
#
# The account is kniha_jizd_app, never `postgres`. It does own this
# container's single database, but it exists nowhere else: the container
# is dedicated to this project, has no host port mapping and sits on its
# own Docker network, so no other project can reach it and this account
# can reach no other project's data.
#
# POSTGRES_DB=kniha_jizd
# POSTGRES_USER=kniha_jizd_app
# POSTGRES_PASSWORD=<generate a long random value, e.g. `openssl rand -hex 24`>
#
# KJ_DB_NAME=kniha_jizd
# KJ_DB_USER=kniha_jizd_app
# KJ_DB_PASSWORD=<same value as POSTGRES_PASSWORD above>
#
# DB_HOST=kniha-jizd-postgres
# DB_PORT=5432
#
# SESSION_SECRET_KEY=<generate a long random value, e.g. `openssl rand -hex 32` - must differ from every other app's key>
# ENVIRONMENT=production
#
# PHOTOS_DIR=/opt/kniha_jizd/data/photos
# DOCUMENTS_DIR=/opt/kniha_jizd/data/documents
